# --- Base de données Aiven ---
DB_HOST=<aiven-host>
DB_PORT=12444
DB_USER=avnadmin
DB_PASSWORD=<à récupérer>
DB_NAME=defaultdb
DB_SSL=true

# --- JWT ---
JWT_SECRET=<votre_secret>
JWT_EXPIRES_IN=7d

# --- Email SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<gmail>
SMTP_PASS=<mot de passe d'application>
MAIL_FROM=<email_expéditeur>
ADMIN_EMAIL=<email_admin1>,<email_admin2>
ADMIN_URL=https://senguichet.vercel.app

# --- URL publique des billets ---
TICKET_URL=<vercel-url>/api/billets

# --- Orange SMS API ---
ORANGE_SANDBOX=true
ORANGE_CLIENT_ID=<client_id>
ORANGE_CLIENT_SECRET=<client_secret>
ORANGE_SENDER_ADDRESS=tel:+221000000000

# --- Wave Business API ---
WAVE_API_KEY=
WAVE_SIGNING_SECRET=
WAVE_BASE_URL=https://api.wave.com/v1
API_BASE_URL=http://localhost:8080/api
