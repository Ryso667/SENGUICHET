# --- Base de données TiDB Cloud ---
DB_HOST=<tidb-host>
DB_PORT=4000
DB_USER=<votre-user>.root
DB_PASSWORD=<votre-password>
DB_NAME=test
DB_SSL=false

# --- JWT ---
JWT_SECRET=<votre-secret>
JWT_EXPIRES_IN=7d

# --- Email SMTP (Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<gmail>
SMTP_PASS=<mot-de-passe-application>
MAIL_FROM=<email-expediteur>
ADMIN_EMAIL=<email-admin>
ADMIN_URL=https://senguichet.vercel.app

# --- URL publique des billets ---
TICKET_URL=https://backend-rust-sigma-64.vercel.app/api/billets

# --- Orange SMS API ---
ORANGE_SANDBOX=true
ORANGE_CLIENT_ID=<orange-client-id>
ORANGE_CLIENT_SECRET=<orange-client-secret>
ORANGE_SENDER_ADDRESS=tel:+221000000000

# --- Wave Business API ---
WAVE_API_KEY=
WAVE_SIGNING_SECRET=
WAVE_BASE_URL=https://api.wave.com/v1
API_BASE_URL=http://localhost:8080/api

# --- Port ---
PORT=8080
