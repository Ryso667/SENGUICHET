# HMAC secret (obligatoire pour le scan QR)
EXPO_PUBLIC_HMAC_SECRET=senguichet-hmac-secret-v1

# Cloudinary
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=<votre_cloud_name>
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=<votre_upload_preset>

# Backend API
API_BASE_URL=https://backend-beta-six-39.vercel.app

# Firebase
EXPO_PUBLIC_FIREBASE_API_KEY=<firebase_api_key>
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=<project>.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=senguichet
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=<project>.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender_id>
EXPO_PUBLIC_FIREBASE_APP_ID=<app_id>

# Google OAuth
EXPO_PUBLIC_FIREBASE_GOOGLE_CLIENT_ID=<google_client_id>
EXPO_PUBLIC_FIREBASE_IOS_CLIENT_ID=<ios_client_id>

# Unsplash
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=<unsplash_key>
